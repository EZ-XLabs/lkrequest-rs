{
  "$schema": "TlsProfile",
  "$comment": "Chrome 131 TLS Fingerprint Profile. UNVERIFIED — 基于 example.com / Wireshark 抓包手工构建，但原始参考数据未保留，未经过 JA3/JA4 一致性测试。生产环境建议优先使用已验证的 chrome_144。All extension_type and cipher suite values are decimal representations of their standard hex code-points.",

  "name": "Chrome 131",

  "tls_client_hello_style": "chromium_boringssl",

  "tls_min_version": "tls12",
  "tls_max_version": "tls13",

  "session_id_length": 32,

  "cipher_suites": [
    4865,  4866,  4867,
    49195, 49199, 49196, 49200,
    52393, 52392,
    49171, 49172,
    156,   157,
    47,    53
  ],

  "compression_methods": [0],
  "ec_point_formats": [0],

  "supported_groups": [
    29, 23, 24
  ],

  "signature_algorithms": [
    1027, 2052, 1025,
    1283, 2053, 1281,
    2054, 1537
  ],

  "alpn_protocols": ["h2", "http/1.1"],

  "key_share_curves": [29],

  "compress_cert_algorithms": [2],

  "alps_protocols": ["h2"],

  "grease": {
    "cipher_suite": true,
    "extensions": true,
    "supported_groups": true,
    "supported_versions": true,
    "signature_algorithms": false
  },

  "randomization": {
    "shuffle_extensions": true
  },

  "padding": {
    "type": "block_align",
    "min_length": 256,
    "block_size": 512
  },

  "extensions": [
    { "extension_type": 0,     "source": { "type": "auto" }, "_comment": "server_name (SNI)" },
    { "extension_type": 23,    "source": { "type": "auto" }, "_comment": "extended_master_secret" },
    { "extension_type": 65281, "source": { "type": "auto" }, "_comment": "renegotiation_info" },
    { "extension_type": 10,    "source": { "type": "auto" }, "_comment": "supported_groups" },
    { "extension_type": 11,    "source": { "type": "auto" }, "_comment": "ec_point_formats" },
    { "extension_type": 35,    "source": { "type": "auto" }, "_comment": "session_ticket" },
    { "extension_type": 16,    "source": { "type": "auto" }, "_comment": "ALPN" },
    { "extension_type": 5,     "source": { "type": "auto" }, "_comment": "status_request (OCSP stapling)" },
    { "extension_type": 13,    "source": { "type": "auto" }, "_comment": "signature_algorithms" },
    { "extension_type": 18,    "source": { "type": "auto" }, "_comment": "signed_certificate_timestamp (SCT)" },
    { "extension_type": 51,    "source": { "type": "auto" }, "_comment": "key_share" },
    { "extension_type": 45,    "source": { "type": "auto" }, "_comment": "psk_key_exchange_modes" },
    { "extension_type": 43,    "source": { "type": "auto" }, "_comment": "supported_versions" },
    { "extension_type": 27,    "source": { "type": "auto" }, "_comment": "compress_certificate" },
    { "extension_type": 17513, "source": { "type": "auto" }, "_comment": "application_settings (ALPS)" },
    { "extension_type": 65278, "source": { "type": "grease" }, "_comment": "GREASE extension (value randomized at runtime)" },
    { "extension_type": 21,    "source": { "type": "auto" }, "_comment": "padding" }
  ]
}
