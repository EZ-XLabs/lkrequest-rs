{
  "$schema": "TlsProfile",
  "$comment": "Safari 18 TLS Fingerprint Profile. UNVERIFIED — 基于 Safari 18 公开 ClientHello 结构推测构建，缺少真实浏览器参考数据，未经过 JA3/JA4 一致性测试。生产环境建议优先使用已验证的 safari_26。Safari has a distinctive cipher suite order, includes GREASE, no ALPS, no compress_certificate, and different supported groups order.",

  "name": "Safari 18",

  "tls_client_hello_style": "safari_cfnetwork",

  "tls_min_version": "tls12",
  "tls_max_version": "tls13",

  "session_id_length": 32,

  "cipher_suites": [
    4865,  4866,  4867,
    49196, 49195, 52393,
    49200, 49199, 52392,
    49188, 49187, 49162, 49161,
    49192, 49191, 49172, 49171,
    157,   156,
    61,    60,
    53,    47,
    255
  ],

  "compression_methods": [0],

  "ec_point_formats": [0],

  "supported_groups": [
    29, 23, 24, 25
  ],

  "signature_algorithms": [
    1027, 1283, 1539,
    2052, 2053, 2054,
    2057, 2058, 2059,
    1025, 1281, 1537,
    515,  769
  ],

  "alpn_protocols": ["h2", "http/1.1"],

  "key_share_curves": [29],

  "grease": {
    "cipher_suite": true,
    "extensions": true,
    "supported_groups": true,
    "supported_versions": true,
    "signature_algorithms": false
  },

  "padding": {
    "type": "none"
  },

  "extensions": [
    { "extension_type": 65278, "source": { "type": "grease" }, "_comment": "GREASE extension" },
    { "extension_type": 0,     "source": { "type": "auto" }, "_comment": "server_name (SNI)" },
    { "extension_type": 23,    "source": { "type": "auto" }, "_comment": "extended_master_secret" },
    { "extension_type": 65281, "source": { "type": "auto" }, "_comment": "renegotiation_info" },
    { "extension_type": 10,    "source": { "type": "auto" }, "_comment": "supported_groups" },
    { "extension_type": 11,    "source": { "type": "auto" }, "_comment": "ec_point_formats" },
    { "extension_type": 16,    "source": { "type": "auto" }, "_comment": "ALPN" },
    { "extension_type": 5,     "source": { "type": "auto" }, "_comment": "status_request (OCSP)" },
    { "extension_type": 13,    "source": { "type": "auto" }, "_comment": "signature_algorithms" },
    { "extension_type": 18,    "source": { "type": "auto" }, "_comment": "signed_certificate_timestamp (SCT)" },
    { "extension_type": 51,    "source": { "type": "auto" }, "_comment": "key_share" },
    { "extension_type": 45,    "source": { "type": "auto" }, "_comment": "psk_key_exchange_modes" },
    { "extension_type": 43,    "source": { "type": "auto" }, "_comment": "supported_versions" },
