{
  "$schema": "TlsProfile",
  "$comment": "Firefox 133 TLS Fingerprint Profile. UNVERIFIED — 基于 Firefox 133 公开 ClientHello 结构推测构建，缺少真实浏览器参考数据，未经过 JA3/JA4 一致性测试。生产环境建议优先使用已验证的 firefox_147。Firefox uses different cipher suite order, no GREASE in cipher suites, includes delegated_credentials and record_size_limit extensions, no ALPS, and 3 EC point formats.",

  "name": "Firefox 133",

  "tls_client_hello_style": "firefox_nss",

  "tls_min_version": "tls12",
  "tls_max_version": "tls13",

  "session_id_length": 32,

  "cipher_suites": [
    4865,  4867,  4866,
    49195, 49199, 52393, 52392,
    49196, 49200,
    49162, 49172, 49161, 49171,
    156,   157,
    47,    53
  ],

  "compression_methods": [0],

  "ec_point_formats": [0, 1, 2],

  "supported_groups": [
    29, 23, 24, 25, 256, 257
  ],

  "signature_algorithms": [
    1027, 1283, 1539,
    2055, 2056,
    2057, 2058, 2059,
    2052, 2053, 2054,
    1025, 1281, 1537
  ],

  "alpn_protocols": ["h2", "http/1.1"],

  "key_share_curves": [29, 23],

  "record_size_limit": 16385,

  "delegated_credentials": {
    "signature_algorithms": [1027, 1283, 1539, 2055, 2056, 2057, 2058, 2059, 2052, 2053, 2054]
  },

  "grease": {
    "cipher_suite": false,
    "extensions": false,
    "supported_groups": false,
    "supported_versions": false,
    "signature_algorithms": false
  },

  "padding": {
    "type": "none"
  },

  "extensions": [
    { "extension_type": 0,     "source": { "type": "auto" }, "_comment": "server_name (SNI)" },
    { "extension_type": 23,    "source": { "type": "auto" }, "_comment": "extended_master_secret" },
    { "extension_type": 65281, "source": { "type": "auto" }, "_comment": "renegotiation_info" },
    { "extension_type": 10,    "source": { "type": "auto" }, "_comment": "supported_groups" },
    { "extension_type": 11,    "source": { "type": "auto" }, "_comment": "ec_point_formats" },
    { "extension_type": 35,    "source": { "type": "auto" }, "_comment": "session_ticket" },
    { "extension_type": 22,    "source": { "type": "auto" }, "_comment": "encrypt_then_mac" },
    { "extension_type": 16,    "source": { "type": "auto" }, "_comment": "ALPN" },
    { "extension_type": 5,     "source": { "type": "auto" }, "_comment": "status_request (OCSP)" },
    { "extension_type": 34,    "source": { "type": "auto" }, "_comment": "delegated_credentials" },
    { "extension_type": 51,    "source": { "type": "auto" }, "_comment": "key_share" },
    { "extension_type": 43,    "source": { "type": "auto" }, "_comment": "supported_versions" },
    { "extension_type": 13,    "source": { "type": "auto" }, "_comment": "signature_algorithms" },
    { "extension_type": 45,    "source": { "type": "auto" }, "_comment": "psk_key_exchange_modes" },
    { "extension_type": 28,    "source": { "type": "auto" }, "_comment": "record_size_limit" },
    { "extension_type": 18,    "source": { "type": "auto" }, "_comment": "signed_certificate_timestamp (SCT)" }
  ]
}
